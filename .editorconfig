root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 140
# The service package is no.fdk.fdk_harvest_archive across all sources.
# Renaming it is a separate refactoring, so the rule is off rather than violated.
ktlint_standard_package-name = disabled

[*.{xml,yaml,yml,json}]
indent_size = 2
